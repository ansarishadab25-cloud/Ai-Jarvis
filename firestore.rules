rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.preferredLanguageCode in ['hi-IN', 'hi-en', 'en-IN'] &&
             data.handsFreeEnabled is bool &&
             data.historyEnabled is bool &&
             (data.speechRate is float || data.speechRate is int) &&
             data.speechRate >= 0.5 &&
             data.speechRate <= 2.0;
    }

    function isValidCommandRecord(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.query is string &&
             data.query.size() >= 1 &&
             data.query.size() <= 1000 &&
             data.response is string &&
             data.response.size() >= 1 &&
             data.response.size() <= 2000 &&
             data.intentType is string &&
             data.intentType.size() >= 1 &&
             data.intentType.size() <= 64 &&
             data.language in ['hi-IN', 'hi-en', 'en-IN'] &&
             data.status in ['COMPLETED', 'FAILED', 'CONFIRMED', 'CANCELLED'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId',
                         'preferredLanguageCode',
                         'handsFreeEnabled',
                         'historyEnabled',
                         'speechRate',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'preferredLanguageCode',
                         'handsFreeEnabled',
                         'historyEnabled',
                         'speechRate',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'preferredLanguageCode',
                         'handsFreeEnabled',
                         'historyEnabled',
                         'speechRate',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /commands/{commandId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(commandId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(commandId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId',
                           'query',
                           'response',
                           'intentType',
                           'language',
                           'status',
                           'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId',
                           'query',
                           'response',
                           'intentType',
                           'language',
                           'status',
                           'createdAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidCommandRecord(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(commandId) && request.auth.uid == userId;
      }
    }
  }
}
